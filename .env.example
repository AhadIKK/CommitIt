# Copy to .env (never commit real secrets; .env* is gitignored)
PORT=3000

# Phase 1+ (Supabase: use pooled 6543 URL here)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/commitit?pgbouncer=true
# Vercel: the Supabase integration reverts DATABASE_URL on sync. Set the
# pooled URL as COMMITIT_DATABASE_URL there instead (never touched).
COMMITIT_DATABASE_URL=
# Supabase direct (5432) for migrations. Local dev can set same as DATABASE_URL.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/commitit
GITHUB_WEBHOOK_SECRET=change-me
GITHUB_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
TELEGRAM_DEFAULT_CHAT_ID=
# Inbound mode. Primary: Telegram POSTs updates to /api/telegram (Vercel,
# always awake) — set the secret here and register it with setWebhook:
#   curl "https://api.telegram.org/bot$TOKEN/setWebhook?url=<APP_URL>/api/telegram&secret_token=<secret>&drop_pending_updates=true"
# Fallback: Render's getUpdates poller, which idles itself while a webhook is
# registered and resumes automatically if the webhook is deleted. Unset this
# and nothing inbound works — the endpoint refuses updates without it.
TELEGRAM_WEBHOOK_SECRET=

# Phase 6: stale-branch checks (comma-separated repos, idle days threshold)
STALE_CHECK_REPOS=
STALE_DAYS=6

# AI layer (Phase 4). AI_PROVIDER: echo (stub) or openai (OpenAI-compatible
# chat API). AI_BASE_URL overrides the endpoint for compatible gateways.
# Prices are USD per 1M tokens; defaults match the default model.
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_INPUT_PRICE=
AI_OUTPUT_PRICE=
AI_MONTHLY_CAP_USD=

# GitHub App (replaces manual webhooks) + GitHub-login accounts.
# Create the App at github.com/settings/apps (or org settings):
# webhook URL https://<your-app>.vercel.app/api/github-app, permissions
# issues:read, pull_requests:read, metadata:read (+ contents:read for sync).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# App private key as base64 (avoids multiline PEM pain in Vercel):
# base64 -w0 < app.pem   (PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("app.pem")))
GITHUB_APP_PRIVATE_KEY_BASE64=
# Alternative: raw PEM with \n escapes on a single line (Render-friendly).
# Either form works; base64 wins only when the raw form is empty.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# OAuth creds of the SAME GitHub App (Settings → General → Client ID/secret).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Signs session cookies. Any long random string; never share/rotate lightly.
SESSION_SECRET=change-me
# Public base URL (Vercel derives it from headers when unset).
APP_URL=
# Long-lived worker host (Render free sleeps; sync pings this after
# enqueueing backfill/digest jobs so queued work actually runs). Unset = skip.
WORKER_URL=

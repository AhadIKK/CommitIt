{
  "name": "commitit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && vite build --config dashboard/vite.config.ts",
    "postinstall": "prisma generate",
    "start": "node dist/index.js",
    "test": "vitest run",
    "bot:setup": "tsx src/setBotCommands.ts",
    "dashboard:dev": "vite --config dashboard/vite.config.ts",
    "dashboard:build": "vite build --config dashboard/vite.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.104.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.7.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}

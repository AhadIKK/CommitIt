{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "regions": [
    "icn1"
  ],
  "rewrites": [
    {
      "source": "/api/telegram",
      "destination": "/api/auth/telegram"
    },
    {
      "source": "/api/me",
      "destination": "/api/product/me"
    },
    {
      "source": "/api/repos",
      "destination": "/api/product/repos"
    },
    {
      "source": "/api/repos/:path*",
      "destination": "/api/product/repos/:path*"
    },
    {
      "source": "/api/ops",
      "destination": "/api/product/ops"
    },
    {
      "source": "/api/auth/github/start",
      "destination": "/api/product/auth/github/start"
    },
    {
      "source": "/api/auth/github/repo",
      "destination": "/api/product/auth/github/repo"
    },
    {
      "source": "/api/link/telegram",
      "destination": "/api/product/link/telegram"
    },
    {
      "source": "/api/link/telegram/:path*",
      "destination": "/api/product/link/telegram/:path*"
    },
    {
      "source": "/api/onboarding/mode",
      "destination": "/api/product/onboarding/mode"
    },
    {
      "source": "/api/worker/tick",
      "destination": "/api/product/worker/tick"
    },
    {
      "source": "/api/progress",
      "destination": "/api/data/progress"
    },
    {
      "source": "/api/activity",
      "destination": "/api/data/activity"
    },
    {
      "source": "/api/issues",
      "destination": "/api/data/issues"
    },
    {
      "source": "/api/digests",
      "destination": "/api/data/digests"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/product/**/*.ts": {
      "maxDuration": 45
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.svg|llms.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, stale-while-revalidate=60"
        }
      ]
    }
  ]
}
